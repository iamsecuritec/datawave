// app/api/webhook/route.js
// Stripe envoie des événements ici pour confirmer les paiements
// C'est la partie la plus importante — elle confirme que le client a vraiment payé

import { NextResponse } from "next/server";
import { stripe } from "@/lib/stripe";
import { headers } from "next/headers";

export async function POST(request) {
  const body = await request.text();
  const headersList = headers();
  const signature = headersList.get("stripe-signature");

  let event;

  // Vérifie que l'événement vient vraiment de Stripe (sécurité)
  try {
    event = stripe.webhooks.constructEvent(
      body,
      signature,
      process.env.STRIPE_WEBHOOK_SECRET
    );
  } catch (err) {
    console.error("Webhook signature invalide:", err.message);
    return NextResponse.json({ error: "Signature invalide" }, { status: 400 });
  }

  // Traite les différents événements Stripe
  switch (event.type) {

    // ✅ Paiement réussi — abonnement créé
    case "checkout.session.completed": {
      const session = event.data.object;
      console.log("✅ Nouveau client payant:", session.customer_email);
      console.log("   Plan:", session.metadata?.plan);
      console.log("   Session ID:", session.id);

      // TODO: Ici tu peux sauvegarder dans une base de données
      // ex: await db.users.update({ email: session.customer_email, isPro: true })
      break;
    }

    // ✅ Abonnement actif (après essai gratuit)
    case "customer.subscription.updated": {
      const subscription = event.data.object;
      console.log("📋 Abonnement mis à jour:", subscription.id);
      console.log("   Status:", subscription.status);
      break;
    }

    // ❌ Abonnement annulé
    case "customer.subscription.deleted": {
      const subscription = event.data.object;
      console.log("❌ Abonnement annulé:", subscription.id);

      // TODO: Révoquer l'accès Pro
      // ex: await db.users.update({ stripeId: subscription.customer, isPro: false })
      break;
    }

    // ❌ Paiement échoué
    case "invoice.payment_failed": {
      const invoice = event.data.object;
      console.log("💳 Paiement échoué pour:", invoice.customer_email);
      break;
    }

    default:
      console.log(`Événement non traité: ${event.type}`);
  }

  return NextResponse.json({ received: true });
}

// Important: désactive le body parsing de Next.js pour les webhooks
export const config = {
  api: { bodyParser: false },
};
